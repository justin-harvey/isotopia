{
  "rules": {
    "questions": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.teacher === true || root.child('admins').child(auth.uid).val() === true)"
    },
    "dailySchedule": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.teacher === true || root.child('admins').child(auth.uid).val() === true)"
    },
    "classes": {
      "$classId": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.teacher === true || root.child('admins').child(auth.uid).val() === true)",
        "members": {
          "$uid": {
            ".write": "auth != null && (auth.token.teacher === true || root.child('admins').child(auth.uid).val() === true)"
          }
        }
      }
    },
    "students": {
      ".read": "auth != null && (auth.token.teacher === true || root.child('admins').child(auth.uid).val() === true)",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.teacher === true || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && auth.uid === $uid && auth.token.email_verified === true"
      }
    },
    "admins": {
      ".read": "auth != null && auth.token.teacher === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.teacher === true)",
        ".write": "auth != null && auth.token.teacher === true"
      }
    }
  }
}
